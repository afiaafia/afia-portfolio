"use client"

import { usePathname } from "next/navigation"
import {
  useCallback,
  useEffect,
  useRef,
  useState,
} from "react"

import {
  createMascotEngine,
} from "./mascot-engine"

import type {
  MascotEngine,
  MascotEngineSnapshot,
} from "./mascot-engine"

import {
  getActionBehavior,
  getRouteGreeting,
  getSceneGreeting,
} from "./mascot-behaviors"

import type {
  MascotAction,
} from "./mascot-types"

import styles from "./mascot.module.css"

const INITIAL_SNAPSHOT: MascotEngineSnapshot = {
  motion: {
    position: { x: 0, y: 0 },
    velocity: { x: 0, y: 0 },
    dragging: false,
    grounded: true,
    jumping: false,
  },
  expression: {
    mood: "idle",
    blink: false,
    eyeOffset: { x: 0, y: 0 },
    sleeping: false,
    lastInteraction: Date.now(),
  },
  activeScene: null,
  target: null,
}


function playKittySound() {
  try {
    const AudioContextClass =
      window.AudioContext ||
      (window as typeof window & {
        webkitAudioContext?: typeof AudioContext
      }).webkitAudioContext

    if (!AudioContextClass) return

    const context = new AudioContextClass()
    const now = context.currentTime
    const oscillator = context.createOscillator()
    const gain = context.createGain()
    const filter = context.createBiquadFilter()

    oscillator.type = "triangle"
    oscillator.frequency.setValueAtTime(780, now)
    oscillator.frequency.exponentialRampToValueAtTime(1100, now + 0.09)
    oscillator.frequency.exponentialRampToValueAtTime(540, now + 0.28)

    filter.type = "lowpass"
    filter.frequency.value = 1800

    gain.gain.setValueAtTime(0.001, now)
    gain.gain.exponentialRampToValueAtTime(0.12, now + 0.035)
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.32)

    oscillator.connect(filter)
    filter.connect(gain)
    gain.connect(context.destination)

    oscillator.start(now)
    oscillator.stop(now + 0.33)
    oscillator.onended = () => void context.close()
  } catch {
    // Audio is optional; mascot interactions should still work.
  }
}

export default function MascotWidget() {
  const pathname = usePathname()
  const engineRef = useRef<MascotEngine | null>(null)
  const rootRef = useRef<HTMLDivElement | null>(null)
  const dragMovedRef = useRef(false)
  const pointerStartRef = useRef<{
    pointerId: number
    point: { x: number; y: number }
  } | null>(null)
  const lastGreetingRef = useRef(0)
  const bubbleTimerRef = useRef<number | null>(null)

  const [snapshot, setSnapshot] =
    useState<MascotEngineSnapshot>(INITIAL_SNAPSHOT)
  const [ready, setReady] = useState(false)
  const [menuOpen, setMenuOpen] = useState(false)
  const [message, setMessage] = useState<string | null>(null)
  const [action, setAction] = useState<MascotAction | null>(null)

  const showMessage = useCallback(
    (nextMessage: string, duration = 2400) => {
      setMessage(nextMessage)

      if (bubbleTimerRef.current !== null) {
        window.clearTimeout(bubbleTimerRef.current)
      }

      if (duration > 0) {
        bubbleTimerRef.current = window.setTimeout(() => {
          setMessage(null)
          bubbleTimerRef.current = null
        }, duration)
      }
    },
    [],
  )

  useEffect(() => {
    const engine = createMascotEngine(
      {
        x: Math.max(12, window.innerWidth - 116),
        y: Math.max(90, window.innerHeight - 164),
      },
      {
        onUpdate: setSnapshot,
        onSceneChange: (sceneId) => {
          const greeting = getSceneGreeting(sceneId)
          if (greeting) showMessage(greeting, 2200)
        },
      },
      {
        reducedMotion: window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches,
        enableCursorTracking: true,
        enableDragging: true,
        enableSceneAwareness: true,
      },
    )

    engineRef.current = engine
    engine.start()
    setReady(true)

    return () => {
      engine.stop()
      engineRef.current = null

      if (bubbleTimerRef.current !== null) {
        window.clearTimeout(bubbleTimerRef.current)
      }
    }
  }, [showMessage])

  useEffect(() => {
    if (!ready || !engineRef.current) return

    const now = Date.now()
    if (now - lastGreetingRef.current < 1800) return

    lastGreetingRef.current = now
    showMessage(getRouteGreeting(pathname), 2600)
    engineRef.current.greet()
  }, [pathname, ready, showMessage])

  const runAction = useCallback(
    (nextAction: MascotAction) => {
      const engine = engineRef.current
      if (!engine) return

      const behavior = getActionBehavior(nextAction)

      setAction(nextAction)
      engine.setMood(behavior.mood)
      showMessage(behavior.message ?? "", behavior.duration || 0)

      if (nextAction === "jump") {
        engine.jump()
      } else if (nextAction === "sleep") {
        engine.sleep()
      } else if (nextAction === "wake") {
        engine.wake()
      } else if (nextAction === "greet" || nextAction === "wave") {
        engine.greet()
      }

      if (nextAction !== "sleep") {
        window.setTimeout(() => {
          setAction((current) =>
            current === nextAction ? null : current,
          )
        }, behavior.duration || 1400)
      }

      setMenuOpen(false)
    },
    [showMessage],
  )

  const handlePointerDown = (
    event: React.PointerEvent<HTMLDivElement>,
  ) => {
    if (
      (event.target as HTMLElement).closest(
        `.${styles.menuToggle}, .${styles.actionMenu}`,
      )
    ) return

    if (!engineRef.current) return

    // Record the pointer first. A click alone must not start dragging.
    pointerStartRef.current = {
      pointerId: event.pointerId,
      point: {
        x: event.clientX,
        y: event.clientY,
      },
    }
    dragMovedRef.current = false
  }

  const handlePointerMove = (
    event: React.PointerEvent<HTMLDivElement>,
  ) => {
    const engine = engineRef.current
    const start = pointerStartRef.current

    if (!engine || !start || start.pointerId !== event.pointerId) {
      return
    }

    const point = {
      x: event.clientX,
      y: event.clientY,
    }

    const distance = Math.hypot(
      point.x - start.point.x,
      point.y - start.point.y,
    )

    if (!engine.getSnapshot().motion.dragging) {
      // Ignore tiny pointer movements so normal clicks still work.
      if (distance < 7) return

      dragMovedRef.current = true
      event.currentTarget.setPointerCapture(event.pointerId)

      engine.beginPointerDrag(event.pointerId, start.point)
    }

    if (engine.getSnapshot().motion.dragging) {
      dragMovedRef.current = true
      engine.movePointerDrag(event.pointerId, point)
    }
  }

  const handlePointerUp = (
    event: React.PointerEvent<HTMLDivElement>,
  ) => {
    const start = pointerStartRef.current

    if (!start || start.pointerId !== event.pointerId) return

    const engine = engineRef.current

    if (engine?.getSnapshot().motion.dragging) {
      engine.endPointerDrag(event.pointerId)
    }

    pointerStartRef.current = null

    if (dragMovedRef.current) {
      showMessage("You can move me anywhere!", 1800)
    }
  }

  const sleeping = snapshot.expression.sleeping ||
    snapshot.expression.mood === "sleeping"

  if (!ready) return null

  return (
    <div
      ref={rootRef}
      className={[
        styles.mascot,
        snapshot.motion.dragging ? styles.dragging : "",
        snapshot.motion.jumping ? styles.jumping : "",
        sleeping ? styles.sleeping : "",
        action ? styles[`action_${action}`] : "",
      ].filter(Boolean).join(" ")}
      style={{
        transform: `translate3d(${snapshot.motion.position.x}px, ${snapshot.motion.position.y}px, 0)`,
      }}
      onPointerDown={handlePointerDown}
      onPointerMove={handlePointerMove}
      onPointerUp={handlePointerUp}
      onPointerCancel={handlePointerUp}
      aria-label="Interactive purple kitty mascot"
    >
      {message && (
        <div className={styles.bubble} role="status">
          {message}
        </div>
      )}

      <button
        type="button"
        className={styles.kittyButton}
        aria-label={sleeping ? "Wake up the kitty" : "Interact with the kitty"}
        onClick={() => {
          if (dragMovedRef.current) {
            dragMovedRef.current = false
            return
          }

          playKittySound()

          if (sleeping) {
            runAction("wake")
          } else {
            runAction("wave")
          }
        }}
      >
        <img
          className={styles.kitty}
          src="/images/kitty.png"
          alt="Cute anime kitty"
          draggable={false}
        />
      </button>

      <button
        type="button"
        className={styles.menuToggle}
        aria-label={menuOpen ? "Close kitty actions" : "Open kitty actions"}
        aria-expanded={menuOpen}
        onClick={() => setMenuOpen((open) => !open)}
      >
        {menuOpen ? "×" : "＋"}
      </button>

      {menuOpen && (
        <div className={styles.actionMenu} aria-label="Kitty actions">
          <button type="button" onClick={() => runAction("wave")}>
            Wave
          </button>
          <button type="button" onClick={() => runAction("jump")}>
            Jump
          </button>
          <button type="button" onClick={() => runAction("spin")}>
            Spin
          </button>
          <button
            type="button"
            onClick={() => runAction(sleeping ? "wake" : "sleep")}
          >
            {sleeping ? "Wake" : "Sleep"}
          </button>
        </div>
      )}
    </div>
  )
}
